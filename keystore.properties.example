# Salin file ini menjadi "keystore.properties" (di root proyek, sudah di-gitignore)
# dan isi dengan kredensial keystore rilis Anda. Jika file "keystore.properties"
# tidak ada, build "release" akan tetap berhasil tanpa signing config khusus
# (memakai default Android Gradle Plugin).
storeFile=/path/ke/pilah-release.jks
storePassword=ganti-dengan-store-password
keyAlias=pilah
keyPassword=ganti-dengan-key-password
